{
  "name": "@luxwallet/eth-coinbase-keyring",
  "version": "0.0.0-beta.1",
  "description": "A keyring that uses the Coinbase Wallet SDK to sign transactions",
  "keywords": [
    "ethereum",
    "keyring"
  ],
  "homepage": "https://github.com/luxfi/eth-coinbase-keyring#readme",
  "bugs": {
    "url": "https://github.com/luxfi/eth-coinbase-keyring/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxfi/eth-coinbase-keyring.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:clean": "rimraf dist && yarn build",
    "build:docs": "typedoc",
    "lint": "yarn lint:eslint && yarn lint:misc --check && yarn lint:dependencies",
    "lint:dependencies": "depcheck",
    "lint:eslint": "eslint . --cache --ext js,ts",
    "lint:fix": "yarn lint:eslint --fix && yarn lint:misc --write",
    "lint:misc": "prettier '**/*.json' '**/*.md' '!CHANGELOG.md' '**/*.yml' '!.yarnrc.yml' --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "test": "jest",
    "test:watch": "jest --watch",
    "example": "vite .",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.3.7",
    "@ethereumjs/util": "^10.1.3",
    "@metamask/eth-sig-util": "^9.0.0",
    "@metamask/utils": "^11.11.0",
    "patch-package": "^8.0.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@ethereumjs/tx": "^10.1.3",
    "@lavamoat/allow-scripts": "^5.1.0",
    "@metamask/auto-changelog": "^6.2.1",
    "@metamask/eslint-config": "^15.0.1",
    "@metamask/eslint-config-jest": "^15.0.1",
    "@metamask/eslint-config-nodejs": "^15.0.1",
    "@metamask/eslint-config-typescript": "^15.0.1",
    "@peculiar/webcrypto": "^1.7.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/ethereumjs-tx": "^2.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "26.4.0",
    "@types/randombytes": "^2.0.3",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "depcheck": "^1.4.7",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.5",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "ethereumjs-tx": "^2.1.2",
    "events": "^3.3.0",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "prettier": "^3.9.6",
    "qrcode.vue": "^3.10.0",
    "ts-jest": "^29.4.12",
    "typedoc": "^0.28.20",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vue": "^3.5.42"
  },
  "engines": {
    "node": "^16.20 || ^18.16 || >=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "lavamoat": {
    "allowScripts": {
      "keccak": true,
      "secp256k1": true,
      "@lavamoat/preinstall-always-fail": false,
      "ethereumjs-tx>ethereumjs-util>ethereum-cryptography>keccak": false,
      "ethereumjs-tx>ethereumjs-util>ethereum-cryptography>secp256k1": false,
      "@coinbase/wallet-sdk>@solana/web3.js>bigint-buffer": false,
      "@coinbase/wallet-sdk>@solana/web3.js>rpc-websockets>bufferutil": false,
      "@coinbase/wallet-sdk>@solana/web3.js>rpc-websockets>utf-8-validate": false,
      "@coinbase/wallet-sdk>keccak": false
    }
  },
  "author": "",
  "license": "ISC"
}
