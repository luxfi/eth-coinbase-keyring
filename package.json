{
  "name": "@luxwallet/eth-coinbase-keyring",
  "version": "0.0.0-beta.1",
  "description": "A keyring that uses the Coinbase Wallet SDK to sign transactions",
  "keywords": [
    "ethereum",
    "keyring"
  ],
  "homepage": "https://github.com/luxfi/eth-coinbase-keyring#readme",
  "bugs": {
    "url": "https://github.com/luxfi/eth-coinbase-keyring/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxfi/eth-coinbase-keyring.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:clean": "rimraf dist && yarn build",
    "build:docs": "typedoc",
    "lint": "yarn lint:eslint && yarn lint:misc --check && yarn lint:dependencies",
    "lint:dependencies": "depcheck",
    "lint:eslint": "eslint . --cache --ext js,ts",
    "lint:fix": "yarn lint:eslint --fix && yarn lint:misc --write",
    "lint:misc": "prettier '**/*.json' '**/*.md' '!CHANGELOG.md' '**/*.yml' '!.yarnrc.yml' --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "test": "jest",
    "test:watch": "jest --watch",
    "example": "vite .",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "catalog:",
    "@ethereumjs/util": "catalog:",
    "@metamask/eth-sig-util": "catalog:",
    "@metamask/utils": "catalog:",
    "patch-package": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@ethereumjs/tx": "catalog:",
    "@lavamoat/allow-scripts": "catalog:",
    "@metamask/auto-changelog": "catalog:",
    "@metamask/eslint-config": "catalog:",
    "@metamask/eslint-config-jest": "catalog:",
    "@metamask/eslint-config-nodejs": "catalog:",
    "@metamask/eslint-config-typescript": "catalog:",
    "@peculiar/webcrypto": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/ethereumjs-tx": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/randombytes": "catalog:",
    "@types/uuid": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "depcheck": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-jest": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-node": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "ethereumjs-tx": "catalog:",
    "events": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "prettier": "catalog:",
    "qrcode.vue": "catalog:",
    "ts-jest": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:"
  },
  "engines": {
    "node": "^16.20 || ^18.16 || >=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "lavamoat": {
    "allowScripts": {
      "keccak": true,
      "secp256k1": true,
      "@lavamoat/preinstall-always-fail": false,
      "ethereumjs-tx>ethereumjs-util>ethereum-cryptography>keccak": false,
      "ethereumjs-tx>ethereumjs-util>ethereum-cryptography>secp256k1": false,
      "@coinbase/wallet-sdk>@solana/web3.js>bigint-buffer": false,
      "@coinbase/wallet-sdk>@solana/web3.js>rpc-websockets>bufferutil": false,
      "@coinbase/wallet-sdk>@solana/web3.js>rpc-websockets>utf-8-validate": false,
      "@coinbase/wallet-sdk>keccak": false
    }
  },
  "author": "",
  "license": "ISC"
}
